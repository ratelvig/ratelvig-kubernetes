# Proxmox API Credentials
pm_api_url          = "https://192.168.2.2:8006/api2/json"
pm_api_token_id     = "terraform@pve!terraform-token"
pm_api_token_secret = "00000000-0000-0000-0000-000000000000"
pm_tls_insecure     = true

# Target Environment Settings
proxmox_target_node = "pve"
vm_template         = "cloud-initv2"
vm_template_id      = 901
ci_user             = "root"
storage_pool        = "local-lvm"
network_bridge      = "vmbr0"
network_cidr        = "192.168.2.0/24"
network_prefix      = 24
network_gateway     = "192.168.2.1"
searchdomain        = "ratelvig.local"

# SSH Public Key for root access
ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExampleKeyForAnsibleAutomation admin@homelab"

# Node Counts & Resource Allocation
server_count     = 1
server_vmid_start = 200
server_ip_start  = 10
server_cores     = 2
server_memory    = 2048
server_swap      = 512
server_disk_size = "20G"

agent_count     = 1
agent_vmid_start = 210
agent_ip_start  = 11
agent_cores     = 2
agent_memory    = 4096
agent_swap      = 512
agent_disk_size = "40G"
